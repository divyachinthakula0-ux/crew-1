// Paste this into https://dbdiagram.io/d  (DRAFT v1)

Table users {
  id uuid [pk]
  name varchar(100) [not null]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table projects {
  id uuid [pk]
  user_id uuid [not null]
  title varchar(150) [not null]
  description text
  status varchar(20) [not null, note: 'open, in_progress, completed, cancelled']
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table orders {
  id bigint [pk]
  user_id uuid [not null]
  project_id uuid
  order_date timestamp
  status varchar(20) [not null]
  total_amount decimal(10,2) [not null]
  created_at timestamp
  updated_at timestamp
}

Table payments {
  id bigint [pk]
  order_id bigint [not null]
  amount decimal(10,2) [not null]
  payment_method varchar(50) [not null]
  payment_status varchar(20)
  transaction_reference varchar(255) [unique]
  paid_at timestamp
  created_at timestamp
  updated_at timestamp
}

Ref: projects.user_id > users.id [delete: cascade]
Ref: orders.user_id > users.id [delete: restrict]
Ref: orders.project_id > projects.id [delete: set null]
Ref: payments.order_id > orders.id [delete: restrict]
